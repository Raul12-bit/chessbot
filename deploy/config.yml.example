# lichess-bot config for Chessbot.
# Copy to lichess-bot/config.yml. The token is NOT stored here:
# lichess-bot reads it from the LICHESS_BOT_TOKEN environment variable (overrides `token`).
token: "set-LICHESS_BOT_TOKEN-env-var"
url: "https://lichess.org/"

engine:
  dir: "./engines/"                # copy bins/best.exe here as chessbot.exe and book/gm_book.bin as book.bin
  name: "chessbot.exe"
  debug: false
  working_dir: ""
  protocol: "uci"
  ponder: false                    # engine does not support pondering

  polyglot:
    enabled: false

  draw_or_resign:
    resign_enabled: false
    resign_score: -1000
    resign_for_egtb_minus_two: true
    resign_moves: 3
    offer_draw_enabled: true
    offer_draw_score: 0
    offer_draw_for_egtb_zero: true
    offer_draw_moves: 10
    offer_draw_pieces: 10

  online_moves:
    max_out_of_book_moves: 10
    max_retries: 2
    chessdb_book:
      enabled: false
    lichess_cloud_analysis:
      enabled: false
    lichess_opening_explorer:
      enabled: false
    online_egtb:
      enabled: false

  lichess_bot_tbs:
    syzygy:
      enabled: false
    gaviota:
      enabled: false

  homemade_options:

  uci_options:                     # only options the engine actually supports
    Hash: 256
    Threads: 8                     # Lazy SMP; lower it if the computer is needed for other work
    Move Overhead: 100

  silence_stderr: false

abort_time: 30
fake_think_time: false
rate_limiting_delay: 0
move_overhead: 2000
max_takebacks_accepted: 0
quit_after_all_games_finish: false

correspondence:
  move_time: 60
  checkin_period: 300
  disconnect_time: 150
  ponder: false

challenge:
  concurrency: 1
  games_reserved_for_humans: 0
  sort_by: "best"
  preference: "none"
  accept_bot: true
  only_bot: false
  max_increment: 20
  min_increment: 0
  max_base: 1800
  min_base: 0
  variants:
    - standard
  time_controls:
    - bullet
    - blitz
    - rapid
  modes:
    - casual
    - rated
  bullet_requires_increment: false
  max_simultaneous_games_per_user: 5

greeting:
  hello: "Hi! I'm {me}, a homemade Rust engine. Good luck!"
  goodbye: "Good game!"
  hello_spectators: "Hi! I'm {me}, a homemade Rust engine."
  goodbye_spectators: "Thanks for watching!"

matchmaking:
  allow_matchmaking: false         # set true to challenge other bots automatically
  allow_during_games: false
  challenge_variant: "random"
  challenge_timeout: 30
  challenge_initial_time:
    - 60
    - 180
  challenge_increment:
    - 1
    - 2
  opponent_rating_difference: 300
  rating_preference: "none"
  challenge_mode: "random"
  challenge_filter: none
  include_challenge_block_list: false
